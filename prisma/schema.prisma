generator client {
  provider = "prisma-client-js"
}

// Runtime (Vercel functions): Supabase transaction pooler, port 6543, ?pgbouncer=true&connection_limit=3.
// Migrations need a direct/session connection (port 5432): DIRECT_URL. Locally both are the same URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ponytail: fixed roles with capabilities mapped in code; move to a roles table when the Owner
// needs to configure them (routes already ask for capabilities, not roles).
enum SiteRole {
  OWNER
  OFFICER
}

enum ResponseStatus {
  IN
  OUT
  TENTATIVE
  BENCH
  LATE // coming, but later: see Response.arrivalTime
}

enum WoWClass {
  WARRIOR
  PALADIN
  HUNTER
  ROGUE
  PRIEST
  SHAMAN
  MAGE
  WARLOCK
  DRUID
  DEATHKNIGHT
  MONK
  EVOKER
  DEMONHUNTER
}

enum WoWRole {
  TANK
  HEALER
  DPS        // melee DPS
  RANGED_DPS
}

model User {
  id           String      @id @default(uuid())
  username     String
  preferredChannel String?    @default("telegram")
  // Admin-site role; null = no site access (players use the bot). Capabilities: src/domain/roles.ts.
  role         SiteRole?
  identities   Identity[]
  characters   Character[]
  eventsCreated Event[]
  groups       GroupMember[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

// One row per linked chat account; a User can have one per platform.
model Identity {
  id             String   @id @default(uuid())
  platform       String   // "telegram" | "discord" | "supabase" (admin-site login; platformUserId = auth user id)
  platformUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([platform, platformUserId])
  @@index([userId])
  @@map("identities")
}

model Character {
  id        String     @id @default(uuid())
  userId    String?    // null = a roster slot nobody has claimed yet
  user      User?      @relation(fields: [userId], references: [id])
  name      String
  realm     String
  class     WoWClass   @default(WARRIOR)
  role      WoWRole    @default(DPS)
  spec      String?    // validated against the class in src/domain/wow.ts
  offSpecs  String[]   @default([]) // other specs it can play, in order of preference
  nickname  String?    // what the guild calls the player; the same nickname groups someone's characters
  isMain    Boolean    @default(true)
  inRoster  Boolean    @default(false) // part of the raid roster officers maintain
  responses Response[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, realm])
  @@map("characters")
}

model RosterGroup {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  members     GroupMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roster_groups")
}

model GroupMember {
  userId    String
  groupId   String
  user      User         @relation(fields: [userId], references: [id])
  group     RosterGroup  @relation(fields: [groupId], references: [id])
  joinedAt  DateTime     @default(now())

  @@id([userId, groupId])
  @@map("group_members")
}

model Event {
  id          String     @id @default(uuid())
  title       String
  startTime   DateTime
  endTime     DateTime
  description String?
  createdBy   String?    // optional until officers have logins
  creator     User?      @relation(fields: [createdBy], references: [id])
  isPublished  Boolean    @default(false)
  responses   Response[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("events")
}

model Response {
  id           String         @id @default(uuid())
  eventId      String
  event        Event          @relation(fields: [eventId], references: [id])
  characterId  String
  character    Character      @relation(fields: [characterId], references: [id])
  status       ResponseStatus @default(TENTATIVE)
  isConfirmed   Boolean    @default(false)
  arrivalTime  DateTime?
  note         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([eventId, characterId])
  @@map("responses")
}

// Half-finished bot conversations (registration steps, "how many minutes late?").
// Serverless instances share no memory, so the next message may land elsewhere: keep them here.
model ChatDraft {
  id             String   @id @default(uuid())
  kind           String   // "registration" | "late"
  platform       String   // "telegram"
  platformUserId String
  data           Json
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt

  @@unique([kind, platform, platformUserId])
  @@map("chat_drafts")
}
