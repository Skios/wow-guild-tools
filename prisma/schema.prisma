generator client {
  provider = "prisma-client-js"
}

// Runtime (Vercel functions): Supabase transaction pooler, port 6543, ?pgbouncer=true&connection_limit=3.
// Migrations need a direct/session connection (port 5432): DIRECT_URL. Locally both are the same URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ResponseStatus {
  IN
  OUT
  TENTATIVE
  BENCH
  LATE // coming, but later: see Response.arrivalTime
}

enum WoWClass {
  WARRIOR
  PALADIN
  HUNTER
  ROGUE
  PRIEST
  SHAMAN
  MAGE
  WARLOCK
  DRUID
  DEATHKNIGHT
  MONK
  EVOKER
  DEMONHUNTER
}

enum WoWRole {
  TANK
  HEALER
  DPS        // melee DPS
  RANGED_DPS
}

model User {
  id           String      @id @default(uuid())
  username     String      // sign-in name (private)
  nickname     String?     // what the guild calls the player; their characters show it
  preferredChannel String?    @default("telegram")
  // Site role; null = no site access. Capabilities: src/domain/roles.ts.
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  passwordChangedAt  DateTime? // a reset link made before this is used up
  mustChangePassword Boolean @default(false) // signed in with a temporary password: only the change-password route works
  identities   Identity[]
  characters   Character[]
  eventsCreated Event[]
  groups       GroupMember[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

// Site roles, configured by the Owner. Lower position = higher rank. Exactly one isOwner and one isDefault
// (partial unique indexes in the migration). capabilities: names registered by the routes (src/domain/roles.ts).
model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  position     Int
  capabilities String[] @default([])
  isDefault    Boolean  @default(false) // given to new accounts
  isOwner      Boolean  @default(false) // has every capability, configures roles
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("roles")
}

// One row per linked chat account; a User can have one per platform.
model Identity {
  id             String   @id @default(uuid())
  platform       String   // "telegram" | "discord" | "supabase" (admin-site login; platformUserId = auth user id)
  platformUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([platform, platformUserId])
  @@index([userId])
  @@map("identities")
}

model Character {
  id        String     @id @default(uuid())
  userId    String?    // null = a roster slot nobody has claimed yet
  user      User?      @relation(fields: [userId], references: [id])
  name      String
  realm     String
  class     WoWClass   @default(WARRIOR)
  role      WoWRole    @default(DPS)
  spec      String?    // validated against the class in src/domain/wow.ts
  offSpecs  String[]   @default([]) // other specs it can play, in order of preference
  nickname  String?    // only for roster slots nobody claimed yet; a claimed character shows its account's nickname
  isMain    Boolean    @default(true)
  inRoster  Boolean    @default(false) // part of the raid roster officers maintain
  responses Response[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, realm])
  @@map("characters")
}

model RosterGroup {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  members     GroupMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roster_groups")
}

model GroupMember {
  userId    String
  groupId   String
  user      User         @relation(fields: [userId], references: [id])
  group     RosterGroup  @relation(fields: [groupId], references: [id])
  joinedAt  DateTime     @default(now())

  @@id([userId, groupId])
  @@map("group_members")
}

model Event {
  id          String     @id @default(uuid())
  title       String
  startTime   DateTime
  endTime     DateTime
  description String?
  createdBy   String?    // optional until officers have logins
  creator     User?      @relation(fields: [createdBy], references: [id])
  isPublished  Boolean    @default(false) // CLOSED: the roster went out; officers may still edit and publish again
  canceledAt  DateTime?  // CANCELED (src/domain/event-state.ts); null = not cancelled
  responses   Response[]
  reminders   Reminder[]
  roleTarget  Json?      // the event's own role target (src/validators/role-target.validator.ts); null = the guild default
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("events")
}

// A private message to whoever hasn't answered, sent once at startTime - minutesBefore.
// pg_cron checks every 5 minutes and calls POST /api/reminders/run when one is due (migration 20261024120000).
model Reminder {
  id            String    @id @default(uuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  minutesBefore Int
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([eventId, minutesBefore])
  @@map("reminders")
}

model Response {
  id           String         @id @default(uuid())
  eventId      String
  event        Event          @relation(fields: [eventId], references: [id])
  characterId  String
  character    Character      @relation(fields: [characterId], references: [id])
  status       ResponseStatus @default(TENTATIVE)
  isConfirmed   Boolean    @default(false)
  arrivalTime  DateTime?
  note         String?
  spec         String?        // the off-spec played that night, set by an officer; null = the main spec
  switchedFrom String?        // the character the player answered with, when an officer switched it
  toldAssignment String?      // "<characterId>|<spec>" last told to the player at publish, so each change is told once
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([eventId, characterId])
  @@map("responses")
}

// Half-finished bot conversations ("a note on your answer?", "how many minutes late?").
// Serverless instances share no memory, so the next message may land elsewhere: keep them here.
model ChatDraft {
  id             String   @id @default(uuid())
  kind           String   // "answer"
  platform       String   // "telegram"
  platformUserId String
  data           Json
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt

  @@unique([kind, platform, platformUserId])
  @@map("chat_drafts")
}

// Guild-wide settings, one row per key (e.g. "roleTarget": the default role target of new events).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
