{
  "name": "wow-guild-tools",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsup src/index.ts --format esm",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma skills sync || exit 0",
    "supabase:keys": "test -f supabase/signing_keys.json || (echo '[]' > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append)",
    "officer": "node --env-file-if-exists=.env --import tsx scripts/officer.ts",
    "vercel-build": "prisma generate && npm --prefix web run build",
    "officer:dev": "node --env-file=.env.dev --import tsx scripts/officer.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.13",
    "telegraf": "^4.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "prisma": "^5.22.0",
    "supabase": "^2.121.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
