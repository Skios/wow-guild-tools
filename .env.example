# Local Supabase (npx supabase start). Hosted: the "Session pooler" string from Connect (port 5432),
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Prisma migrations only. Locally the same URL; hosted: the Session pooler (port 5432).
# On Vercel DATABASE_URL is the Transaction pooler: ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
PORT=3000
# "true" on Vercel (its edge sets X-Forwarded-For to the real client IP); leave unset locally
# TRUST_PROXY=true

# Telegram Bot Config
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHANNEL_ID="your_channel_id_here"
# 16-256 chars, only A-Z a-z 0-9 _ -  (sent by Telegram in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="your_random_secret_string"

# Times in bot messages (IANA zone). Default Europe/Rome.
# GUILD_TIME_ZONE="Europe/Rome"

# Reminders: shared with Supabase Vault "reminders_secret" (README "Reminders"). 32-256 chars, A-Z a-z 0-9 _ -
# e.g. `openssl rand -hex 32`. Unset = reminders off.
# REMINDERS_SECRET=""

# Supabase project whose logins the admin site uses (local: npx supabase start)
SUPABASE_URL="http://127.0.0.1:54321"
# Creates and manages logins: `npm run officer`, sign-up and password resets. API only (on Vercel: the API
# project, marked Sensitive), never the site. Local: the SECRET_KEY printed by `npx supabase status`.
# SUPABASE_SECRET_KEY=""

# The site's address: the bot's /start sends a sign-up link to it. Local: the Next dev server.
SITE_URL="http://127.0.0.1:5173"
