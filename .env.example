DATABASE_URL="postgresql://user:password@localhost:5432/wow_guild_tools"
PORT=3000

# Telegram Bot Config
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHANNEL_ID="your_channel_id_here"
# 16-256 chars, only A-Z a-z 0-9 _ -  (sent by Telegram in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="your_random_secret_string"

# Shared key for officer routes (send as x-api-key)
API_KEY="your_random_api_key_min_16_chars"
